# Leave Supabase values empty for the clearly labeled browser-only demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key. Required for a live deployment.
VITE_TURNSTILE_SITE_KEY=
# Keep / for Cloudflare Workers Static Assets.
VITE_BASE_PATH=/

# Local Docker runtime. Generate independent random values; never commit them.
LOCAL_DB_PASSWORD=
LOCAL_API_PASSWORD=
LOCAL_MFA_KEY=
